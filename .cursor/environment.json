{
  "name": "Asset Management System",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && java -jar target/server.jar"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0"
    }
  ],
  "ports": [5173, 8080]
}
